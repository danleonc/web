{
  "name": "conexiones-humanas-prototipo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "npm run test:rules && npm run test:server && playwright test",
    "typecheck": "tsc -b",
    "deploy:pages": "npm run build && node scripts/publish-pages.mjs",
    "test:rules": "node --test tests/rules/*.test.mjs",
    "dev:api": "node server/main.ts",
    "dev:shared": "node scripts/dev-shared.mjs",
    "test:server": "node --test tests/server/*.test.mjs"
  },
  "dependencies": {
    "lucide-react": "1.57.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.1",
    "@playwright/test": "1.64.1",
    "@types/node": "24.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "^6.0.0",
    "typescript": "~5.9.3",
    "vite": "8.3.4"
  },
  "engines": {
    "node": ">=24.0.0 <25",
    "npm": ">=11.0.0"
  }
}
